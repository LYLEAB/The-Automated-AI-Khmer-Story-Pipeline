# ============================================================
# .env.example — Copy this file to .env and fill in your keys
# Never commit .env to version control!
# ============================================================

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google Cloud TTS (Primary Khmer TTS) ---
# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service_account.json

# --- ElevenLabs TTS (Fallback) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Find your voice ID at https://elevenlabs.io/voice-lab
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Stability AI / SDXL (Image Gen Fallback) ---
STABILITY_API_KEY=your_stability_api_key_here

# --- Optional: Background Music ---
# Leave empty to disable background music mixing
BACKGROUND_MUSIC_PATH=assets/background_music.mp3

# --- Pipeline Behavior ---
# "google_tts" | "elevenlabs" | "gtts"
TTS_PROVIDER=gtts
# "gemini_imagen" | "stability_ai"
IMAGE_PROVIDER=gemini_imagen
# Set to "true" to skip already-generated assets (resumable mode)
RESUME_ON_RESTART=true

# --- Supabase (optional — enables persistent job history + cloud storage) ---
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
