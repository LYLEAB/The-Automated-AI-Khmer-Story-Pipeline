# ============================================================
# .gitignore — Automated AI Khmer Story Pipeline
# ============================================================

# Secrets
.env
*.json.key
service_account*.json

# Python virtual environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Output directories & artifacts
output/
output/*
*.mp4
*.mp3
*.png

# Assets that may contain large binary files
assets/audio/*
!assets/audio/.gitkeep
assets/fonts/*
!assets/fonts/NotoSansKhmer-Regular.ttf

# MoviePy / FFmpeg temp files
*TEMP_MPY*
*.tmp
*.temp

# IDE & OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
